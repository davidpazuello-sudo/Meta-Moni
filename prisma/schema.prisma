generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// METAGOV UI ENGINE TABLES [7-9]
// ==========================================

model UiModule {
  id          String   @id @default(uuid())
  slug        String   @unique
  label       String
  icon        String?  @default("FileText")
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tabs        UiTab[]
}

model UiTab {
  id        String    @id @default(uuid())
  moduleId  String
  module    UiModule  @relation(fields: [moduleId], references: [id])
  slug      String
  label     String
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  blocks    UiBlock[]

}

model UiBlock {
  id             String   @id @default(uuid())
  blockType      String   // table, form, dashboard, report, filter, button, input, custom [10, 11]
  blockId        String?  @unique // ID técnico, ex: table_solicitacoes [12]
  label          String?
  config         Json     @default("{}") // Config JSON do bloco [11]
  tabId          String?
  tab            UiTab?   @relation(fields: [tabId], references: [id])
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  layoutColSpan  Int      @default(12) // Grid 12 colunas [13]
  layoutRow      Int      @default(0)
  style          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// BUSINESS TABLES (CIDADE NA MÃO) [14-16]
// ==========================================

model Citizen {
  id        String   @id @default(cuid())
  fullName  String
  cpf       String   @unique
  phone     String?
  createdAt DateTime @default(now())
}

model Protocol {
  id             String   @id @default(cuid())
  protocolNumber String   @unique
  citizenId      String
  citizen        Citizen  @relation(fields: [citizenId], references: [id])
  channel        String
  message        String
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}
